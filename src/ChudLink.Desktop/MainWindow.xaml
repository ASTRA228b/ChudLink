<Window x:Class="ChudLink.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ChudLink — By ChudAI" Width="1370" Height="900" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#090D0A" Foreground="#E7EDE8" Icon="Assets/ChudLink.ico">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#101612" BorderBrush="#263029" BorderThickness="0,0,1,0"><DockPanel Margin="18,25">
   <StackPanel DockPanel.Dock="Top" Margin="4,0,0,27"><StackPanel Orientation="Horizontal"><Image Source="Assets/ChudLink.png" Width="40" Height="40" Margin="0,0,7,0"/><TextBlock Text="ChudLink" FontSize="25" FontWeight="Bold" Foreground="#C6FF2E" VerticalAlignment="Center"/></StackPanel><TextBlock Text="BY CHUDAI  /  0.1.1 ALPHA" Foreground="#768B7C" FontSize="10" Margin="5,9,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="8,12,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,0,15"><Image Source="Assets/ChudGPT.png" Width="25" Height="25" Margin="0,0,7,0"/><TextBlock Text="A CHUDGPT APP" FontSize="10" Foreground="#A3B699" VerticalAlignment="Center"/></StackPanel><TextBlock Text="LOCAL FIRST. LIMITLESS." FontSize="10" Foreground="#7A8F80"/><TextBlock x:Name="SidebarStatus" Text="○  HOST STOPPED" FontSize="11" Foreground="#C6FF2E" Margin="0,12,0,0"/><Button Content="Quit ChudLink" Click="Quit_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,13" Foreground="#899B8E"/></StackPanel>
   <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_SelectionChanged" Padding="0"><ListBoxItem Content="Overview"/><ListBoxItem Content="Devices"/><ListBoxItem Content="Presets"/><ListBoxItem Content="Designer"/><ListBoxItem Content="Developer Studio"/><ListBoxItem Content="Extensions"/><ListBoxItem Content="Settings"/><ListBoxItem Content="Diagnostics"/><ListBoxItem Content="Connection guide"/><ListBoxItem Content="About"/></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,24,32,16"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock x:Name="Breadcrumb" Text="WORKSPACE / OVERVIEW" FontSize="10" Foreground="#7F9586"/><TextBlock x:Name="PageTitle" Text="Mission control" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="#334B36" Background="#142117" BorderThickness="1" CornerRadius="12" Padding="12,5"><TextBlock Text="●  PUBLIC ALPHA" Foreground="#C6FF2E" FontSize="10"/></Border></Grid>
   <Border x:Name="NoticeBorder" Grid.Row="1" Background="#1D2A16" CornerRadius="6" Padding="12,9" Margin="0,4,0,14" Visibility="Collapsed"><TextBlock x:Name="NoticeText" Foreground="#C5E7A9" FontSize="12"/></Border>
   <ContentControl x:Name="PageContent" Grid.Row="2"/>
   <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="CHUDLINK / YOUR PHONE. YOUR HARDWARE." Foreground="#54675A" FontSize="9"/><TextBlock x:Name="FooterStatus" Text="Ready" HorizontalAlignment="Right" Foreground="#829689" FontSize="10"/></Grid>
  </Grid>
 </Grid>
</Window>
